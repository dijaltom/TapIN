platform :ios, '15.1'
use_frameworks! :linkage => :static

# Uncomment this line to define a global platform for your project
# platform :ios, '13.4'

# React Native pods
require_relative '../node_modules/react-native/scripts/react_native_pods'


prepare_react_native_project!

target 'TapIN' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # Enables Hermes engine
    :hermes_enabled => true,
    # Enables Fabric (New Architecture)
    :fabric_enabled => false,
  )

  # ── React Native Reanimated ──
  pod 'RNReanimated', :path => '../node_modules/react-native-reanimated'

  # ── NFC Manager ──
  pod 'react-native-nfc-manager', :path => '../node_modules/react-native-nfc-manager'

  # ── Linear Gradient ──
  pod 'RNLinearGradient', :path => '../node_modules/react-native-linear-gradient'

  # ── Vision Camera ──
  pod 'VisionCamera', :path => '../node_modules/react-native-vision-camera'

  # ── SVG ──
  pod 'RNSVG', :path => '../node_modules/react-native-svg'

  # ── Haptic Feedback ──
  pod 'RNHapticFeedback', :path => '../node_modules/react-native-haptic-feedback'

  # ── MMKV ──
  pod 'MMKV', :path => '../node_modules/react-native-mmkv'

  # ── Gesture Handler ──
  pod 'RNGestureHandler', :path => '../node_modules/react-native-gesture-handler'

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
    )
    # Fix deployment target for all pods
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.1'
        config.build_settings['SWIFT_VERSION'] = '5.0'
      end
    end
  end
end
